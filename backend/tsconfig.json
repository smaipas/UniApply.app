{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "strict": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@uniapply/shared": ["../packages/shared/src"]
    }
  },
  "include": ["src/**/*.ts"]
}
