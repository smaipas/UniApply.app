# AWS Configuration
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=your-account-id

# Database Tables (auto-generated by serverless)
USERS_TABLE=uniapply-app-users-dev
FORMS_TABLE=uniapply-app-forms-dev
APPLICATIONS_TABLE=uniapply-app-applications-dev
ROLES_TABLE=uniapply-app-roles-dev
AUDIT_TABLE=uniapply-app-audit-dev

# Email Configuration
SES_SENDER_EMAIL=no-reply@uniapply.app

# CORS Configuration
FRONTEND_URL=http://localhost:5173
PRODUCTION_URL=https://uniapply.app
STAGING_URL=https://dev.uniapply.app

# Application Configuration
APP_NAME=UniApply

# AWS SSM Parameters (set these via AWS CLI or use the setup script)
# 
# Dev Stage:
# aws ssm put-parameter --name "/uniapply/dev/api/domainName" --type String --value "api-dev.uniapply.app"
# aws ssm put-parameter --name "/uniapply/dev/frontend/domainName" --type String --value "dev.uniapply.app"
# aws ssm put-parameter --name "/uniapply/dev/appBaseUrl" --type String --value "https://dev.uniapply.app"
# aws ssm put-parameter --name "/uniapply/dev/route53/hostedZoneId" --type String --value "YOUR_HOSTED_ZONE_ID"
# aws ssm put-parameter --name "/uniapply/dev/acm/certArn" --type String --value "arn:aws:acm:eu-central-1:YOUR_ACCOUNT_ID:certificate/YOUR_CERT_ID"
#
# Prod Stage:
# aws ssm put-parameter --name "/uniapply/prod/api/domainName" --type String --value "api.uniapply.app"
# aws ssm put-parameter --name "/uniapply/prod/frontend/domainName" --type String --value "uniapply.app"
# aws ssm put-parameter --name "/uniapply/prod/appBaseUrl" --type String --value "https://uniapply.app"
# aws ssm put-parameter --name "/uniapply/prod/route53/hostedZoneId" --type String --value "YOUR_HOSTED_ZONE_ID"
# aws ssm put-parameter --name "/uniapply/prod/acm/certArn" --type String --value "arn:aws:acm:eu-central-1:YOUR_ACCOUNT_ID:certificate/YOUR_CERT_ID"
#
# Or use the setup script: ./scripts/setup-ssm-params.ps1 (Windows) or ./scripts/setup-ssm-params.sh (Linux/Mac)
